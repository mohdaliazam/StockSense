generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password_hash String
  role          String // INVENTORY_MANAGER or WAREHOUSE_STAFF
  created_at    DateTime    @default(now())
  stockMoves    StockMove[]
}

model Product {
  id             String           @id @default(uuid())
  name           String
  sku            String           @unique
  category       String
  uom            String
  created_at     DateTime         @default(now())
  inventoryLevel InventoryLevel[]
  stockMoves     StockMove[]
}

model Warehouse {
  id        String     @id @default(uuid())
  name      String
  location  String
  locations Location[]
}

model Location {
  id             String           @id @default(uuid())
  warehouse_id   String
  name           String
  warehouse      Warehouse        @relation(fields: [warehouse_id], references: [id])
  inventoryLevel InventoryLevel[]
  sourceMoves    StockMove[]      @relation("SourceLocation")
  destMoves      StockMove[]      @relation("DestLocation")
}

model InventoryLevel {
  id          String   @id @default(uuid())
  product_id  String
  location_id String
  quantity    Float
  product     Product  @relation(fields: [product_id], references: [id])
  location    Location @relation(fields: [location_id], references: [id])

  @@unique([product_id, location_id])
}

model StockMove {
  id                 String    @id @default(uuid())
  product_id         String
  source_location_id String?
  dest_location_id   String?
  quantity           Float
  type               String // RECEIPT, DELIVERY, INTERNAL_TRANSFER, ADJUSTMENT
  status             String // DRAFT, WAITING, READY, DONE, CANCELED
  created_at         DateTime  @default(now())
  created_by         String
  product            Product   @relation(fields: [product_id], references: [id])
  sourceLocation     Location? @relation("SourceLocation", fields: [source_location_id], references: [id])
  destLocation       Location? @relation("DestLocation", fields: [dest_location_id], references: [id])
  user               User      @relation(fields: [created_by], references: [id])
}
